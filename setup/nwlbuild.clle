               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW610R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW620R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))

/* ---- RPG/400 ------------------------------------------------------- */
  CRTRPGPGM  PGM(NWLEGPGM/NW700R) SRCFILE(NWLEGPGM/QRPGSRC) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))

/* ---- OPM CL ---------------------------------------------------------- */
  CRTCLPGM   PGM(NWLEGPGM/NW000C) SRCFILE(NWLEGPGM/QCLSRC) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTCLPGM   PGM(NWLEGPGM/NW620C) SRCFILE(NWLEGPGM/QCLSRC) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTCLPGM   PGM(NWLEGPGM/NW700C) SRCFILE(NWLEGPGM/QCLSRC) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))

  CHGVAR     VAR(&ERRTXT) VALUE(&ERRORS)
  SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('NWLEGACY setup +
               finished with' *BCAT &ERRTXT *BCAT 'error(s). Start +
               with CALL NWLEGPGM/NW000C.') MSGTYPE(*COMP)
  RETURN

  SUBR       SUBR(IMPORT)
    CHGVAR     VAR(&STMF) VALUE(&SRCDIR *TCAT '/' *TCAT &SRCF *TCAT +
                 '/' *TCAT &MBR *TCAT '.' *TCAT &EXT)
    CHGVAR     VAR(&TOMBR) VALUE('/QSYS.LIB/NWLEGPGM.LIB/' *TCAT &SRCF +
                 *TCAT '.FILE/' *TCAT &MBR *TCAT '.MBR')
    CPYFRMSTMF FROMSTMF(&STMF) TOMBR(&TOMBR) MBROPT(*REPLACE) +
                 STMFCCSID(*STMF) DBFCCSID(*FILE) ENDLINFMT(*ALL)
    MONMSG     MSGID(CPF0000) EXEC(DO)
      CHGVAR     VAR(&ERRORS) VALUE(&ERRORS + 1)
      RTNSUBR
    ENDDO
    CHGPFM     FILE(NWLEGPGM/&SRCF) MBR(&MBR) SRCTYPE(&TYPE)
    MONMSG     MSGID(CPF0000)
  ENDSUBR
ENDPGM
