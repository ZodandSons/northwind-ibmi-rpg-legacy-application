/*===================================================================*/
/* NWLBUILD - Set up the NWLEGACY training application               */
/*                                                                   */
/* SETUP TOOLING - NOT PART OF THE LEGACY APPLICATION.               */
/*  1. Creates libraries NWLEGDTA (data) and NWLEGPGM (programs).    */
/*     These names are hard coded in the application (NW000C,        */
/*     NW700C), so they cannot be changed here.                      */
/*  2. Copies the IFS sources into source files in NWLEGPGM.         */
/*  3. Creates the DDS physical/logical files and data areas.        */
/*  4. Loads data from the NORTHWIND schema (qsqlsrc/nwlconv.sql).   */
/*  5. Compiles display files, RPG IV, RPG/400 and CL programs.      */
/*                                                                   */
/* CALL NWLBUILD PARM(('/home/me/nwlegacy' (*CHAR 128)))             */
/*===================================================================*/
PGM        PARM(&SRCDIR)
  DCL        VAR(&SRCDIR) TYPE(*CHAR) LEN(128)
  DCL        VAR(&SRCF)   TYPE(*CHAR) LEN(10)
  DCL        VAR(&MBR)    TYPE(*CHAR) LEN(10)
  DCL        VAR(&EXT)    TYPE(*CHAR) LEN(10)
  DCL        VAR(&TYPE)   TYPE(*CHAR) LEN(10)
  DCL        VAR(&STMF)   TYPE(*CHAR) LEN(256)
  DCL        VAR(&TOMBR)  TYPE(*CHAR) LEN(128)
  DCL        VAR(&ERRORS) TYPE(*DEC)  LEN(5 0) VALUE(0)
  DCL        VAR(&ERRTXT) TYPE(*CHAR) LEN(5)

  CRTLIB     LIB(NWLEGDTA) TEXT('Northwind legacy - data')
  MONMSG     MSGID(CPF2111)
  CRTLIB     LIB(NWLEGPGM) TEXT('Northwind legacy - programs')
  MONMSG     MSGID(CPF2111)
  ADDLIBLE   LIB(NWLEGDTA)
  MONMSG     MSGID(CPF2103)
  ADDLIBLE   LIB(NWLEGPGM)
  MONMSG     MSGID(CPF2103)
  CRTSRCPF   FILE(NWLEGPGM/QDDSSRC) RCDLEN(92)
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(NWLEGPGM/QRPGLESRC) RCDLEN(112)
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(NWLEGPGM/QRPGSRC) RCDLEN(92)
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(NWLEGPGM/QCLSRC) RCDLEN(92)
  MONMSG     MSGID(CPF7302)

/* ---- copy sources ------------------------------------------------- */
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('CODTBL')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('CUSDEM')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('CUSMST')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('EMPMST')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('EMPNOT')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('EMPTER')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('ORDDTL')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('ORDHDR')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('PRDMST')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('SUPMST')
  CHGVAR     VAR(&EXT) VALUE('PF')
  CHGVAR     VAR(&TYPE) VALUE('PF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('CUSMSTL1')
  CHGVAR     VAR(&EXT) VALUE('LF')
  CHGVAR     VAR(&TYPE) VALUE('LF')
