  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('ORDHDRL1')
  CHGVAR     VAR(&EXT) VALUE('LF')
  CHGVAR     VAR(&TYPE) VALUE('LF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('PRDMSTL1')
  CHGVAR     VAR(&EXT) VALUE('LF')
  CHGVAR     VAR(&TYPE) VALUE('LF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('SUPMSTL1')
  CHGVAR     VAR(&EXT) VALUE('LF')
  CHGVAR     VAR(&TYPE) VALUE('LF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW000D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW100D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW190D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW200D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW300D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW400D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW490D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW500D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW510D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW520D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW600D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NW610D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('DATCHK')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW100R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW190R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW200R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW300R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW400R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW490R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW500R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW510R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW520R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW600R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW610R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
  CHGVAR     VAR(&MBR) VALUE('NW620R')
  CHGVAR     VAR(&EXT) VALUE('RPGLE')
  CHGVAR     VAR(&TYPE) VALUE('RPGLE')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QRPGSRC')
  CHGVAR     VAR(&MBR) VALUE('NW700R')
  CHGVAR     VAR(&EXT) VALUE('RPG')
  CHGVAR     VAR(&TYPE) VALUE('RPG')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QCLSRC')
  CHGVAR     VAR(&MBR) VALUE('NW000C')
  CHGVAR     VAR(&EXT) VALUE('CLP')
  CHGVAR     VAR(&TYPE) VALUE('CLP')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QCLSRC')
  CHGVAR     VAR(&MBR) VALUE('NW620C')
  CHGVAR     VAR(&EXT) VALUE('CLP')
  CHGVAR     VAR(&TYPE) VALUE('CLP')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QCLSRC')
  CHGVAR     VAR(&MBR) VALUE('NW700C')
  CHGVAR     VAR(&EXT) VALUE('CLP')
  CHGVAR     VAR(&TYPE) VALUE('CLP')
  CALLSUBR   SUBR(IMPORT)

/* ---- database files (physical first, then logical) ----------------- */
  CRTPF      FILE(NWLEGDTA/CODTBL) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTPF      FILE(NWLEGDTA/CUSDEM) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTPF      FILE(NWLEGDTA/CUSMST) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTPF      FILE(NWLEGDTA/EMPMST) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTPF      FILE(NWLEGDTA/EMPNOT) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTPF      FILE(NWLEGDTA/EMPTER) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTPF      FILE(NWLEGDTA/ORDDTL) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTPF      FILE(NWLEGDTA/ORDHDR) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTPF      FILE(NWLEGDTA/PRDMST) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTPF      FILE(NWLEGDTA/SUPMST) SRCFILE(NWLEGPGM/QDDSSRC) SIZE(*NOMAX)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTLF      FILE(NWLEGDTA/CUSMSTL1) SRCFILE(NWLEGPGM/QDDSSRC)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTLF      FILE(NWLEGDTA/CUSMSTL2) SRCFILE(NWLEGPGM/QDDSSRC)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTLF      FILE(NWLEGDTA/EMPMSTL1) SRCFILE(NWLEGPGM/QDDSSRC)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTLF      FILE(NWLEGDTA/EMPMSTL2) SRCFILE(NWLEGPGM/QDDSSRC)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTLF      FILE(NWLEGDTA/ORDHDRL1) SRCFILE(NWLEGPGM/QDDSSRC)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTLF      FILE(NWLEGDTA/PRDMSTL1) SRCFILE(NWLEGPGM/QDDSSRC)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTLF      FILE(NWLEGDTA/SUPMSTL1) SRCFILE(NWLEGPGM/QDDSSRC)
  MONMSG     MSGID(CPF7302) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))

/* ---- data areas ------------------------------------------------------ */
  CRTDTAARA  DTAARA(NWLEGDTA/NWNXTORD) TYPE(*DEC) LEN(7 0) VALUE(11078) +
               TEXT('Next order number')
  MONMSG     MSGID(CPF1023)
  CRTDTAARA  DTAARA(NWLEGDTA/NWNXTPRD) TYPE(*DEC) LEN(5 0) VALUE(78) +
               TEXT('Next product number')
  MONMSG     MSGID(CPF1023)
  CRTDTAARA  DTAARA(NWLEGDTA/NWCOMP) TYPE(*CHAR) LEN(40) +
               VALUE('NORTHWIND TRADERS') TEXT('Company name')
  MONMSG     MSGID(CPF1023)

/* ---- load data from NORTHWIND ---------------------------------------- */
  CHGVAR     VAR(&STMF) VALUE(&SRCDIR *TCAT '/QSQLSRC/NWLCONV.SQL')
  RUNSQLSTM  SRCSTMF(&STMF) COMMIT(*NONE) NAMING(*SQL)
  MONMSG     MSGID(CPF0000 SQL0000) EXEC(CHGVAR VAR(&ERRORS) +
               VALUE(&ERRORS + 1))

/* ---- display files ---------------------------------------------------- */
  CRTDSPF    FILE(NWLEGPGM/NW000D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW100D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW190D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW200D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW300D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW400D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW490D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW500D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW510D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW520D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW600D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTDSPF    FILE(NWLEGPGM/NW610D) SRCFILE(NWLEGPGM/QDDSSRC) RSTDSP(*YES) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))

/* ---- RPG IV (DFTACTGRP(*YES) - OPM compatible, like the shop did) --- */
/*  DATCHK is a /COPY member - not compiled                          */
  CRTBNDRPG  PGM(NWLEGPGM/NW100R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW190R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW200R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW300R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW400R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW490R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW500R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW510R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDRPG  PGM(NWLEGPGM/NW520R) SRCFILE(NWLEGPGM/QRPGLESRC) +
               DFTACTGRP(*YES) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
