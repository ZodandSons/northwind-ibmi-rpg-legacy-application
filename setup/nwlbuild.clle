  CHGVAR     VAR(&MBR) VALUE('EMPMSTL1')
  CHGVAR     VAR(&EXT) VALUE('LF')
  CHGVAR     VAR(&TYPE) VALUE('LF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('EMPMSTL2')
  CHGVAR     VAR(&EXT) VALUE('LF')
  CHGVAR     VAR(&TYPE) VALUE('LF')
